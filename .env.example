# Never paste secrets into chat. Load private credentials only in the launch shell with xtrace off.
OPENAI_API_KEY=
UNIVERSITYDB_MODEL=gpt-6.1-sol
UNIVERSITYDB_LIVE_APPROVED=no
# H009 explicit practical estimate policy, NOT a guaranteed bill or old BILLING_VERIFIED proof.
UNIVERSITYDB_BUDGET_POLICY=practical-v1
UNIVERSITYDB_RATES_CONFIRMED=no
UNIVERSITYDB_CAP_USD=10
# Fixed dispatch threshold 8 / buffer 2 are code policy, never per-launch budgets.
# Fresh official default-tier conservative short-context category envelope; confirm before live.
UNIVERSITYDB_INPUT_USD_PER_MILLION=5.50
UNIVERSITYDB_OUTPUT_USD_PER_MILLION=11
# Local environment is not automatically loaded. Export explicitly; API endpoint is pinned in code.
